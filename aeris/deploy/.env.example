# AERIS production settings. Copy to .env, fill in, keep it on the server only (chmod 600 .env).

# Public name of the server, as in the HTTPS certificate (no https://, no path)
AERIS_HOST=aeris.africacdc.org

# Image to run (built from the aeris/v0.9.8 branch, see DEPLOY.md)
AERIS_IMAGE=aeris:0.9.8-acdc15

# Database passwords: long random values (e.g. openssl rand -base64 24). Never reuse.
DATASOURCE_USERNAME=aeris
DATASOURCE_PASSWORD=
MYSQL_ROOT_PASSWORD=

TZ=Africa/Kinshasa

# Microsoft 365 sign-in (from Africa CDC IT's Entra app registration). Leave ENABLED=false until ready.
AERIS_ENTRA_ENABLED=false
AERIS_ENTRA_TENANT_ID=
AERIS_ENTRA_CLIENT_ID=
AERIS_ENTRA_CLIENT_SECRET=
AERIS_ENTRA_EMAIL_DOMAINS=africacdc.org

# Backups (scripts/backup.sh)
BACKUP_DIR=/var/backups/aeris
BACKUP_KEEP_DAYS=30
# Optional off-server copy, e.g. "rclone copy {file} azure:aeris-backups" or "scp {file} backup@host:/srv/aeris/"
BACKUP_OFFSITE_CMD=
